APP_NAME=SpendCalc
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_NAME=spend-calc

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@spend-calc.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Telegram bot ---
TELEGRAM_TOKEN=
TELEGRAM_LOG_CHANNEL=stack

# --- Bybit ---
BYBIT_API_BASE_URL=https://api.bybit.com
BYBIT_API_RECV_WINDOW=5000

VITE_APP_NAME="${APP_NAME}"